# Réservation en ligne — voir RESERVATION.md
# À poser dans Vercel (Settings → Environment Variables), jamais dans le dépôt.

# Google Agenda (obligatoire en production)
GOOGLE_CALENDAR_ID=xxxxxxxx@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=reservation@mon-projet.iam.gserviceaccount.com
# La clé privée du fichier JSON, sur une ligne, avec les \n tels quels.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Signature des liens d'annulation (obligatoire, 32 caractères au moins).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_SECRET=

# Courriels de confirmation (facultatif ; sans eux, la réservation marche quand même)
# Option 1 : Gmail. Mot de passe d'application (Compte Google → Sécurité →
# Mots de passe des applications), jamais le mot de passe du compte.
SMTP_USER=barbier@gmail.com
SMTP_PASSWORD=
# Option 2 : Resend, une fois royalmk.ca vérifié. Prioritaire si posé.
RESEND_API_KEY=
BOOKING_FROM_EMAIL="Barbier RoyalMK <rendezvous@royalmk.ca>"
# Reçoit une copie de chaque réservation et annulation, et les alertes de panne.
SALON_NOTIFY_EMAIL=

# Agenda de démonstration en production (aperçu seulement, jamais en ligne).
# BOOKING_DEMO=1
